# URL de l'API backend. En dev, laisser vide pour utiliser le proxy Vite (/api).
# En production, garder "/api" : le rewrite Vercel (voir vercel.json) proxyfie
# /api/* vers le backend, ce qui rend le cookie de session "first-party"
# (indispensable pour rester connecte sur Safari/iOS).
VITE_API_URL=/api

# URL publique du site, utilisee pour les QR codes et les balises SEO.
# En production : https://mon-celebra.vercel.app
VITE_PUBLIC_URL=https://mon-celebra.vercel.app
