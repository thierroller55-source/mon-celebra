# Environnement
NODE_ENV=development
PORT=5000

# Base de donnees MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/moncelebra

# Authentification
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=changez-moi-aussi-avec-une-autre-chaine-aleatoire
REFRESH_TOKEN_EXPIRES_IN=30d
# Cookie refresh : "lax" par defaut (front et API sur le meme domaine via le
# proxy Vercel). Mettre "none" uniquement si le front et l'API sont servis sur
# des domaines totalement distincts sans proxy (exige HTTPS).
# COOKIE_SAMESITE=none

# URLs
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=3

# Stockage des images : "local" (backend/uploads) ou "cloudinary"
STORAGE_DRIVER=local
# Cloudinary (requis si STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Emails transactionnels via Brevo (optionnel : desactive si vide)
BREVO_API_KEY=
MAIL_FROM=no-reply@moncelebra.com
MAIL_FROM_NAME=Mon Celebra
# MAIL_REPLY_TO=contact@moncelebra.com
