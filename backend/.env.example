# Environnement
NODE_ENV=development
PORT=5000

# Base de donnees MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/moncelebra

# Authentification
JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=changez-moi-aussi-avec-une-autre-chaine-aleatoire
REFRESH_TOKEN_EXPIRES_IN=7d
# Cookie refresh : "lax" (meme domaine) ou "none" (front et API sur des
# domaines differents, exige HTTPS). Non defini = "none" en production.
# COOKIE_SAMESITE=none

# URLs
CLIENT_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=3

# Stockage des images : "local" (backend/uploads) ou "cloudinary"
STORAGE_DRIVER=local
# Cloudinary (requis si STORAGE_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
